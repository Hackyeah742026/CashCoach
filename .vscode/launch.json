{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Run CashCoach.Api (Scalar)",
            "type": "coreclr",
            "request": "launch",
            "preLaunchTask": "build-api",
            "program": "${workspaceFolder}/backend/src/CashCoach.Api/bin/Debug/net9.0/CashCoach.Api.dll",
            "cwd": "${workspaceFolder}/backend/src/CashCoach.Api",
            "env": {
                "ASPNETCORE_ENVIRONMENT": "Development"
            },
            "serverReadyAction": {
                "action": "openExternally",
                "pattern": "\\bNow listening on:\\s+(https?://\\S+)",
                "uriFormat": "%s/scalar/v1"
            }
        },
        {
            "name": "Run Frontend (Vite)",
            "type": "node-terminal",
            "request": "launch",
            "command": "npm run dev",
            "cwd": "${workspaceFolder}/frontend",
            "serverReadyAction": {
                "action": "openExternally",
                "pattern": "Local:\\s+(https?://\\S+)",
                "uriFormat": "%s"
            }
        }
    ],
    "compounds": [
        {
            "name": "Backend + Frontend",
            "configurations": [
                "Run CashCoach.Api (Scalar)",
                "Run Frontend (Vite)"
            ],
            "stopAll": true
        }
    ]
}
