
# GEMINI EXAMPLES
GEMINI_API_KEY=gemini_api_key
GEMINI_PROJECT_NAME=gemini_project_name
GEMINI_KEY_NAME=gemini_key_name
GEMINI_PROJECT_ID=gemini_project_id
# Optional: model override (default gemini-3.5-flash-lite)
GEMINI_MODEL=


# Frontend (Vite reads VITE_* vars)
VITE_API_URL=http://localhost:5080/api
# true (default) = frontend uses built-in mock data; set to false once the backend is running
VITE_USE_MOCKS=true
